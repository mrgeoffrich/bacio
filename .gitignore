# Build artifacts
/bacio
*.exe
/dist/

# Per-worktree workspace bacio binary (BACI-139) — `./build.sh` inside a
# linked worktree writes `.bin/bacio-agent-<slug>` for smoke-testing the
# in-progress change. Never installed to PATH; lives and dies with the
# worktree, so it must never end up in a commit.
/.bin/

# Web UI bundle (BACI-30) — populated by `./build.sh --web` or
# `npm --prefix desktop/frontend run build:web` + copy. The .gitkeep
# is the embed.go anchor so `//go:embed all:webui` doesn't error on
# a clean checkout.
/webui/*
!/webui/.gitkeep

# Vite build output for the web bundle (the source of what gets
# copied into /webui/).
/desktop/frontend/dist-web/

# Go
go.work
go.work.sum
/coverage.out
/coverage.html

# Local databases / runtime state
*.sqlite
*.sqlite-shm
*.sqlite-wal
.bacio/

# Design docs produced by the design dispatch — shipped as bacio docs
# attached to the issue, not as repo files.
/docs/designs/

# Local Claude Code config (per-machine, not shared)
.claude/settings.json
.claude/worktrees/

# IDE / OS
.vscode/
.idea/
.DS_Store
.playwright-cli
environment-config.yaml
